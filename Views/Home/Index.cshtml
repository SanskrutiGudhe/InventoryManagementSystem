<!-- File Path: Views/Home/Index.cshtml -->
@model IEnumerable<InventoryManagement.Models.Product>

@{
    ViewData["Title"] = "Dashboard";
}

<div class="pb-2 mb-4 border-bottom">
    <h1 class="display-5 fw-bold text-dark">Inventory Performance Dashboard</h1>
    <p class="text-muted">Real-time statistics, active critical low-stock alerts, and transaction flow metrics.</p>
</div>

<!-- Aggregation Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h6 class="text-uppercase mb-1 opacity-75">Active Products</h6>
                    <h2 class="display-6 fw-bold">@ViewBag.TotalProducts</h2>
                </div>
                <small class="mt-2 text-white-50">Catalogued Items</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h6 class="text-uppercase mb-1 opacity-75">Gross Revenue</h6>
                    <h2 class="display-6 fw-bold">@ViewData["GrossSalesRevenue"]</h2>
                </div>
                <small class="mt-2 text-white-50">Accumulated outward values</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h6 class="text-uppercase mb-1 opacity-75">Physical Stock Pool</h6>
                    <h2 class="display-6 fw-bold">@ViewBag.TotalStockInWarehouse</h2>
                </div>
                <small class="mt-2 text-white-50">Units currently on-shelf</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-dark text-white h-100 shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h6 class="text-uppercase mb-1 opacity-75">Total Ledger Invoices</h6>
                    <h2 class="display-6 fw-bold">@(ViewBag.TotalSalesTransactions + ViewBag.TotalPurchasesTransactions)</h2>
                </div>
                <small class="mt-2 text-white-50">Combined Sales & Purchases</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Column: Partial Alert View -->
    <div class="col-lg-7">
        <!-- Render low stock partial, passing the model -->
       
            @await Html.PartialAsync("_LowStockAlertsPartial", Model)
        

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Quick Operations Panel</h5>
            </div>
            <div class="card-body d-flex gap-2 flex-wrap">
                <a asp-controller="Product" asp-action="Create" class="btn btn-outline-primary">New Catalog Entry</a>
                <a asp-controller="Purchase" asp-action="Create" class="btn btn-outline-success">Record Purchase Shipment</a>
                <a asp-controller="Sales" asp-action="Create" class="btn btn-outline-danger">Log Outbound Invoice</a>
            </div>
        </div>
    </div>

    <!-- Right Column: Visual Business Reports (Chart.js via CDN) -->
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light text-dark">
                <h5 class="mb-0">📊 Top 5 Products Sold (Units)</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                @if (ViewBag.ChartData != null && ViewBag.ChartData.Length > 0)
                {
                    <div style="width: 100%; max-height: 280px;">
                        <canvas id="salesChart"></canvas>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center mb-0">No sales transactions documented yet to build graphs.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Load Chart.js CDN for clean visual dashboard rendering -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var ctx = document.getElementById('salesChart');
        if (ctx) {
            // Retrieve dynamic arrays passed from controller ViewBags
            var labels = @Html.Raw(Json.Serialize(ViewBag.ChartLabels));
            var dataValues = @Html.Raw(Json.Serialize(ViewBag.ChartData));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Units Transacted',
                        data: dataValues,
                        backgroundColor: 'rgba(54, 162, 235, 0.75)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1.5,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }
    });
</script>
