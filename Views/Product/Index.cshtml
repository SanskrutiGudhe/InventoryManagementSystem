<!-- File Path: Views/Product/Index.cshtml -->
@model IEnumerable<InventoryManagement.Models.Product>

@{
    ViewData["Title"] = "Warehouse Product Catalog";

    // Read Paging Metrics out of the ViewData context
    int pageIndex = (int)ViewData["PageIndex"]!;
    int totalPages = (int)ViewData["TotalPages"]!;
    bool hasPrev = (bool)ViewData["HasPreviousPage"]!;
    bool hasNext = (bool)ViewData["HasNextPage"]!;
    string currentSort = (string)ViewData["CurrentSort"]!;
    string currentFilter = (string)ViewData["CurrentFilter"]!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Warehouse Product Catalog</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add New Product</a>
</div>

<!-- Search Panel -->
<form asp-action="Index" method="get" class="mb-4">
    <input type="hidden" name="sortOrder" value="@currentSort" />
    <div class="input-group col-md-6">
        <input type="text" name="searchString" value="@currentFilter" class="form-control" placeholder="Search product names..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="Index" class="btn btn-outline-danger">Reset</a>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Product Code</th>
            <!-- Clickable Interactive Headers using HTML Tag Helpers to Toggle Sort Directions -->
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]" asp-route-searchString="@currentFilter" class="text-white text-decoration-none">
                    Name @(currentSort == "" ? "▲" : (currentSort == "name_desc" ? "▼" : ""))
                </a>
            </th>
            <th>Category</th>
            <th>Supplier</th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSortParm"]" asp-route-searchString="@currentFilter" class="text-white text-decoration-none">
                    Price @(currentSort == "Price" ? "▲" : (currentSort == "price_desc" ? "▼" : ""))
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["StockSortParm"]" asp-route-searchString="@currentFilter" class="text-white text-decoration-none">
                    Stock Count @(currentSort == "Stock" ? "▲" : (currentSort == "stock_desc" ? "▼" : ""))
                </a>
            </th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">No matching catalog records found.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                var stockBadgeClass = item.Stock < 5 ? "bg-danger" : "bg-success";
                <tr>
                    <td>PRD-@item.ProductId</td>
                    <td><strong>@item.ProductName</strong></td>
                    <td>@item.Category?.CategoryName</td>
                    <td>@item.Supplier?.SupplierName</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>
                        <span class="badge @stockBadgeClass">@item.Stock units</span>
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- Server Side Pagination Navigation Links -->
@if (totalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center mt-4">
        <div>
            <span class="text-muted">Page <strong>@pageIndex</strong> of <strong>@totalPages</strong></span>
        </div>
        <ul class="pagination mb-0">
            <li class="page-item @(hasPrev ? "" : "disabled")">
                <a asp-action="Index"
                   asp-route-sortOrder="@currentSort"
                   asp-route-searchString="@currentFilter"
                   asp-route-pageNumber="@(pageIndex - 1)"
                   class="page-link">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == pageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-sortOrder="@currentSort"
                       asp-route-searchString="@currentFilter"
                       asp-route-pageNumber="@i">@i</a>
                </li>
            }

            <li class="page-item @(hasNext ? "" : "disabled")">
                <a asp-action="Index"
                   asp-route-sortOrder="@currentSort"
                   asp-route-searchString="@currentFilter"
                   asp-route-pageNumber="@(pageIndex + 1)"
                   class="page-link">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}
