@{
}
<!-- File Path: Views/Shared/_LowStockAlertsPartial.cshtml -->
@model IEnumerable<InventoryManagement.Models.Product>

<div class="card border-danger mb-4">
    <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">⚠️ Critical Low Stock Warnings</h5>
        <span class="badge bg-white text-danger">@Model.Count() Items Alerting</span>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-success mb-0">✔ All inventory levels are healthy! No low stock warnings.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product Name</th>
                            <th>Current Stock</th>
                            <th>Supplier Contact</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.ProductName</strong></td>
                                <td>
                                    <span class="badge bg-danger">@item.Stock units left</span>
                                </td>
                                <td>
                                    @item.Supplier?.SupplierName <br />
                                    <small class="text-muted">📞 @item.Supplier?.Phone</small>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Purchase" asp-action="Create" asp-route-productId="@item.ProductId" class="btn btn-sm btn-outline-success">
                                        Restock
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
