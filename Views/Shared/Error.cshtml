@model ErrorViewModel

@{
    ViewData["Title"] = "System Error";
}

<div class="text-center py-5">
    <h1 class="text-danger display-3">⚠️ An Error Occurred</h1>
    <h2 class="text-muted">The system ran into an unexpected database or server issue.</h2>

    <hr class="my-4" />

    <p class="lead">
        Don't worry! No transactions were corrupted.
        Please navigate back to the dashboard and try again.
    </p>

    @if (Model != null && Model.ShowRequestId)
    {
        <p class="text-muted">
            <code>Diagnostic Tracking Token: @Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary mt-3">
        Return to Dashboard
    </a>
</div>