@model InventoryManagement.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<h2 class="text-danger">Delete Supplier</h2>
<h3>Are you sure you want to delete this supplier?</h3>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Supplier Name</dt>
        <dd class="col-sm-9">@Model.SupplierName</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.Phone</dd>
    </dl>
    
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="SupplierId" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
